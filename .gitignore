# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# Agent VC credentials store (contains key material — never commit)
artifacts/api-server/agent-credentials/

# Stay Agent's did:web private key (scripts/gen-stay-did-key.mjs writes here).
# The runtime reads it from STAY_DID_PRIVATE_KEY_B64 in the environment; the tree never
# holds it. Do not remove this rule — the 0600 mode the script sets is a no-op on Windows,
# so this ignore is the only thing keeping the key out of a commit.
artifacts/api-server/secrets/

# dependencies
node_modules

# secrets — never commit local env
.env
.env.*
!.env.example

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
.vercel
.env*
