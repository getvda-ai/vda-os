# ============================================================================
# VDA-OS / citizenM Stay Agent — local (off-Replit) environment
# Copy to `.env` (repo root) and fill in. Loaded by the API server via
# node --env-file-if-exists. Never commit the real `.env`.
# ============================================================================

# --- Core ---------------------------------------------------------------
PORT=8080
NODE_ENV=development

# PostgreSQL connection string (Neon / Cloud SQL / local Postgres).
# node-postgres Pool — a standard postgres:// URL. For Neon use the POOLED string.
DATABASE_URL=postgres://user:password@host:5432/vda_os

# --- AI provider (decision engine) -------------------------------------
# "vertex"  → Claude on Google Vertex AI (ADC auth, no API key). RECOMMENDED here.
# "anthropic" → Anthropic API / gateway via ANTHROPIC_API_KEY.
AI_PROVIDER=vertex

# Vertex: GCP project that has Claude enabled in Model Garden + aiplatform API on.
ANTHROPIC_VERTEX_PROJECT_ID=c2md-493808
# A region where the Claude models are enabled (e.g. us-east5, europe-west1).
CLOUD_ML_REGION=us-east5
# Optional Model Garden id overrides (defaults track current Claude releases):
# VERTEX_CLAUDE_SONNET=claude-sonnet-4-5@20250929
# VERTEX_CLAUDE_OPUS=claude-opus-4-1@20250805
# VERTEX_CLAUDE_HAIKU=claude-haiku-4-5@20251001
# Auth: run `gcloud auth application-default login` (ADC). No key needed.

# Fallback if AI_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=   # only for a gateway; omit for api.anthropic.com

# --- Apaleo sandbox (live data) ----------------------------------------
# OAuth2 client-credentials app from your Apaleo sandbox account.
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
# Optional scopes (space-separated). Defaults cover reservations/folios/inventory reads.
# APALEO_SCOPES=
# Bind the demo tenant to a specific sandbox property; else the first property is used.
# CITIZENM_DEMO_PROPERTY_ID=

# --- UCP (reused platform feature) -------------------------------------
OFFER_HMAC_SECRET=change-me-local-dev-secret
